{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/99x-Projects/compliance-automation/contracts/schemas/compliance-report.v1.schema.json",
  "title": "Compliance report (v1)",
  "description": "Structured output of one audit execution (report.json), written by a compliance skill next to its Markdown report. One execution may assess several controls. The publisher flattens it into one AI Hub event per control.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "standard", "standardKey", "repository", "baseline", "runAt", "executionId", "pluginVersion", "scope", "sources", "notAssessed", "controls"],
  "properties": {
    "schema": { "const": "compliance-report.v1" },
    "standard": {
      "description": "Display name, e.g. 'ISO 9001:2015'.",
      "type": "string", "minLength": 1, "maxLength": 100
    },
    "standardKey": { "$ref": "compliance-common.v1.schema.json#/$defs/standardKey" },
    "repository": { "$ref": "compliance-common.v1.schema.json#/$defs/repository" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 200 },
        "commit": { "$ref": "compliance-common.v1.schema.json#/$defs/commit" }
      }
    },
    "runAt": {
      "description": "When the audit ran (UTC). Orders runs; ingest time is never used for ordering.",
      "type": "string", "format": "date-time"
    },
    "executionId": {
      "description": "Xianix EXECUTION_ID, or a local id for runs outside Xianix.",
      "type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 120
    },
    "pluginVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcesMode", "gitScope"],
      "properties": {
        "sourcesMode": {
          "description": "'implicit-git-repo' = no sources file; only the repository was used. Lower confidence than 'declared'.",
          "enum": ["declared", "implicit-git-repo"]
        },
        "sourcesFile": { "type": "string", "maxLength": 300 },
        "gitScope": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": { "$ref": "compliance-common.v1.schema.json#/$defs/source" }
    },
    "notAssessed": {
      "description": "Evidence the audit knowingly could not see (undeclared systems, repository settings, …).",
      "type": "array", "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "$ref": "compliance-common.v1.schema.json#/$defs/metricValue" },
        "cacheReadTokens": { "$ref": "compliance-common.v1.schema.json#/$defs/metricValue" },
        "costUsd": { "$ref": "compliance-common.v1.schema.json#/$defs/metricValue" },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "controls": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control", "controlTitle", "controlGroup", "overall", "summary", "obligations", "actions", "sections", "reportMd"],
        "properties": {
          "control": { "$ref": "compliance-common.v1.schema.json#/$defs/controlId" },
          "controlTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
          "controlGroup": {
            "description": "Immediate parent in the control catalogue (e.g. '8' for 8.1, 'A.5' for A.5.15). Lets the UI roll up large standards.",
            "$ref": "compliance-common.v1.schema.json#/$defs/controlId"
          },
          "overall": {
            "description": "The skill's own overall verdict for this control. The Hub stores it as reported.",
            "$ref": "compliance-common.v1.schema.json#/$defs/verdict"
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "obligations": {
            "type": "array", "minItems": 1, "maxItems": 200,
            "items": { "$ref": "compliance-common.v1.schema.json#/$defs/obligation" }
          },
          "actions": {
            "type": "array", "maxItems": 100,
            "items": { "$ref": "compliance-common.v1.schema.json#/$defs/action" }
          },
          "sections": {
            "type": "array", "maxItems": 30,
            "items": { "$ref": "compliance-common.v1.schema.json#/$defs/section" }
          },
          "reportMd": {
            "description": "The human report for this control. Capped at 200 KB; truncate with a marker.",
            "type": "string", "minLength": 1, "maxLength": 204800
          }
        }
      }
    }
  }
}
